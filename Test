function Library:Tab(name)
    local tab = {}
    tab.Library = self
    
    -- Tab Button
    local TabButton = Instance.new("TextButton")
    TabButton.Name = name .. "_Tab"
    TabButton.Size = UDim2.new(0, 76, 0, 36)
    TabButton.BackgroundColor3 = Color3.fromRGB(44, 44, 44)
    TabButton.Text = name
    TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.TextSize = 20
    TabButton.FontFace = Font.new("rbxasset://fonts/families/HighwayGothic.json")
    TabButton.Parent = self.TabsContainer
    
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 5)
    
    -- Tab Page
    local Page = Instance.new("ScrollingFrame")
    Page.Name = name .. "_Page"
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 2
    Page.ScrollingDirection = Enum.ScrollingDirection.Y
    Page.ElasticBehavior = Enum.ElasticBehavior.Never
    Page.Visible = false
    Page.Parent = self.Mains
    
    -- Frame Main dentro da página
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 526, 0, 256)
    Main.BackgroundTransparency = 1
    Main.Parent = Page
    
    Instance.new("UICorner", Main)
    
    local MainStroke = Instance.new("UIStroke", Main)
    MainStroke.Transparency = 0.7
    MainStroke.Color = Color3.fromRGB(255, 255, 255)
    
    -- Auto Layout System
    local Layout = Instance.new("UIListLayout", Main)
    Layout.Padding = UDim.new(0, 8)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    local Padding = Instance.new("UIPadding", Main)
    Padding.PaddingTop = UDim.new(0, 10)
    Padding.PaddingLeft = UDim.new(0, 6)
    
    -- Update Canvas Size
    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Main.Size = UDim2.new(0, 526, 0, math.max(256, Layout.AbsoluteContentSize.Y + 20))
        Page.CanvasSize = UDim2.new(0, 0, 0, Main.Size.Y.Offset)
    end)

    tab.Page = Page
    tab.Main = Main
    tab.Button = TabButton

    TabButton.MouseButton1Click:Connect(function()
        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(44, 44, 44)
        end
        Page.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(172, 51, 255)
    end)

    -- Default to first tab
    if #self.Tabs == 0 then
        Page.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(172, 51, 255)
    end

    table.insert(self.Tabs, tab)
    
    -- Component Methods
    function tab:Toggle(text, default, callback)
        local toggle = {}
        default = default or false
        callback = callback or function() end
        
        local ToggleFrame = Instance.new("Frame")
        ToggleFrame.Name = "Toggle"
        ToggleFrame.Size = UDim2.new(0, 500, 0, 24)
        ToggleFrame.BackgroundTransparency = 1
        ToggleFrame.Parent = tab.Main
        
        local ToggleBt = Instance.new("ImageButton")
        ToggleBt.Name = "ToggleBt"
        ToggleBt.Size = UDim2.new(0, 24, 0, 24)
        ToggleBt.BackgroundColor3 = default and Color3.fromRGB(172, 51, 255) or Color3.fromRGB(44, 44, 44)
        ToggleBt.Parent = ToggleFrame
        
        Instance.new("UICorner", ToggleBt).CornerRadius = UDim.new(0, 5)
        
        local Title = Instance.new("TextLabel")
        Title.Name = "Title"
        Title.Size = UDim2.new(0, 400, 0, 24)
        Title.Position = UDim2.new(0, 32, 0, 0)
        Title.Text = text
        Title.TextColor3 = Color3.fromRGB(255, 255, 255)
        Title.TextSize = 16
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.BackgroundTransparency = 1
        Title.FontFace = Font.new("rbxasset://fonts/families/HighwayGothic.json")
        Title.Parent = ToggleFrame
        
        local state = default
        ToggleBt.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(ToggleBt, TweenInfo.new(0.2), {
                BackgroundColor3 = state and Color3.fromRGB(172, 51, 255) or Color3.fromRGB(44, 44, 44)
            }):Play()
            callback(state)
        end)
        
        return toggle
    end
    
    function tab:Slider(text, min, max, default, callback)
        local slider = {}
        min = min or 0
        max = max or 100
        default = default or min
        callback = callback or function() end
        
        local SliderFrame = Instance.new("Frame")
        SliderFrame.Name = "Slider"
        SliderFrame.Size = UDim2.new(0, 512, 0, 24)
        SliderFrame.BackgroundTransparency = 1
        SliderFrame.Parent = tab.Main
        
        local Title = Instance.new("TextLabel")
        Title.Name = "Title"
        Title.Size = UDim2.new(0, 90, 0, 24)
        Title.Text = text
        Title.TextColor3 = Color3.fromRGB(255, 255, 255)
        Title.TextSize = 16
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.BackgroundTransparency = 1
        Title.FontFace = Font.new("rbxasset://fonts/families/HighwayGothic.json")
        Title.Parent = SliderFrame
        
        local SliderBar = Instance.new("Frame")
        SliderBar.Name = "SliderBar"
        SliderBar.Size = UDim2.new(0, 416, 0, 16)
        SliderBar.Position = UDim2.new(0, 92, 0, 4)
        SliderBar.BackgroundColor3 = Color3.fromRGB(44, 44, 44)
        SliderBar.BorderColor3 = Color3.fromRGB(44, 44, 44)
        SliderBar.Parent = SliderFrame
        
        Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(0, 5)
        
        local Bar = Instance.new("Frame")
        Bar.Name = "Bar"
        Bar.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        Bar.BackgroundColor3 = Color3.fromRGB(172, 51, 255)
        Bar.Parent = SliderBar
        
        Instance.new("UICorner", Bar).CornerRadius = UDim.new(0, 5)

        local function Update(input)
            local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * pos)
            
            Bar.Size = UDim2.new(pos, 0, 1, 0)
            callback(val)
        end
        
        local dragging = false
        
        SliderBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                Update(input)
            end
        end)
        
        SliderBar.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                Update(input)
            end
        end)
        
        return slider
    end
    
    return tab
end

return Library
