            Title.TextSize = 13  
            Title.TextXAlignment = Enum.TextXAlignment.Left  
            Title.FontFace = FontStyle  

            local Info = Instance.new("TextLabel")  
            Info.Parent = SliderFrame  
            Info.BackgroundTransparency = 1  
            Info.Position = UDim2.new(1, -60, 0, 8)  
            Info.Size = UDim2.new(0, 50, 0, 20)  
            Info.Text = tostring(Default) .. Suffix  
            Info.TextColor3 = Library.Theme.Text  
            Info.TextSize = 13  
            Info.TextXAlignment = Enum.TextXAlignment.Right  
            Info.FontFace = FontStyleBold  

            local SliderMain = Instance.new("Frame")  
            SliderMain.Parent = SliderFrame  
            SliderMain.BackgroundColor3 = Color3.fromRGB(20, 20, 24)  
            SliderMain.Position = UDim2.new(0, 10, 0, 36)  
            SliderMain.Size = UDim2.new(1, -20, 0, 4)  
            local SMCorner = Instance.new("UICorner"); SMCorner.CornerRadius=UDim.new(1,0); SMCorner.Parent = SliderMain  

            local SliderBar = Instance.new("Frame")  
            SliderBar.Parent = SliderMain  
            SliderBar.BackgroundColor3 = Library.Theme.Accent  
            SliderBar.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)  
            local SBCorner = Instance.new("UICorner"); SBCorner.CornerRadius=UDim.new(1,0); SBCorner.Parent = SliderBar  

            local Cursor = Instance.new("Frame")  
            Cursor.Parent = SliderMain  
            Cursor.BackgroundColor3 = Library.Theme.Text  
            Cursor.Position = UDim2.new((Default - Min) / (Max - Min), -6, 0, -4)  
            Cursor.Size = UDim2.new(0, 12, 0, 12)  
            local CCorner = Instance.new("UICorner")  
            CCorner.CornerRadius = UDim.new(1, 0); CCorner.Parent = Cursor  

            local dragging = false  
            local LastValue = Default  
            local LastUpdate = 0  

            local function Update(input)  
                if Library.IsDraggingWindow then return end  

                local now = tick()  
                if now - LastUpdate < 1/60 then return end  
                LastUpdate = now  

                local pos = math.clamp((input.Position.X - SliderMain.AbsolutePosition.X) / SliderMain.AbsoluteSize.X, 0, 1)  
                local val = math.floor(Min + (Max - Min) * pos)  

                if val == LastValue then return end  
                LastValue = val  

                Info.Text = tostring(val) .. Suffix  
                Library:Tween(SliderBar, {Size = UDim2.new(pos, 0, 1, 0)})
                Library:Tween(Cursor, {Position = UDim2.new(pos, -6, 0, -4)})
                
                Library.Flags[Flag] = val  

                task.spawn(function()  
                    Callback(val)  
                end)  
            end  

            SliderMain.InputBegan:Connect(function(input)  
                if Library.IsDraggingWindow then return end  
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then  
                    dragging = true  
                    Library.IsDraggingSlider = true  
                    SetAllScrollingEnabledFast(false)  
                    Library:Tween(Cursor, {Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(SliderBar.Size.X.Scale, -8, 0, -6)})
                    Update(input)  
                end  
            end)  

            UserInputService.InputEnded:Connect(function(input)  
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then  
                    dragging = false  
                    Library.IsDraggingSlider = false  
                    SetAllScrollingEnabledFast(true)  
                    Library:Tween(Cursor, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(SliderBar.Size.X.Scale, -6, 0, -4)})
                end  
            end)  

            RegisterInputConnection(function(input)  
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then  
                    Update(input)  
                end  
            end)  

            Library.Flags[Flag] = Default  
        end  

