                if Library.IsDraggingWindow then return end  
                DropdownData.Opened = not DropdownData.Opened  

                if DropdownData.Opened then  
                    RegisterOpenDropdown(DropdownData)  
                else  
                    for i, d in ipairs(Library.OpenDropdowns) do  
                        if d == DropdownData then  
