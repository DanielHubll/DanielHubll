                Text = text,
                TextColor3 = Library.Theme.Text,
                FontFace = Library.Theme.Font,
                TextSize = 20,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = toggleFrame
            })

            local enabled = default
            Library.Flags[flag] = enabled

            local function UpdateToggle()
                if enabled then
                    Tween(toggleBtn, {BackgroundColor3 = Library.Theme.ToggleOn}, 0.2)
                    toggleBtn.Image = "rbxassetid://130396712201457"
                else
                    Tween(toggleBtn, {BackgroundColor3 = Library.Theme.ToggleOff}, 0.2)
                    toggleBtn.Image = ""
                end
                Library.Flags[flag] = enabled
                callback(enabled)
            end

            toggleBtn.MouseButton1Click:Connect(function()
                enabled = not enabled
                UpdateToggle()
            end)

            if default then
                UpdateToggle()
            end

            return {
                Set = function(value)
                    enabled = value
                    UpdateToggle()
                end,
                Get = function()
                    return enabled
                end
            }
        end

        function Tab:AddSlider(sliderConfig)
            sliderConfig = sliderConfig or {}
            local text = sliderConfig.Text or "Slider"
            local side = sliderConfig.Side or "Main1"
            local min = sliderConfig.Min or 0
            local max = sliderConfig.Max or 100
            local default = sliderConfig.Default or min
            local increment = sliderConfig.Increment or 1
            local callback = sliderConfig.Callback or function() end
            local flag = sliderConfig.Flag or text

            local parent = side == "Main1" and main1Scroll or side == "Main2" and main2Scroll or main1Scroll

            local sliderFrame = Create("Frame", {
                Name = text .. "Slider",
                Size = UDim2.new(1, -10, 0, 50),
