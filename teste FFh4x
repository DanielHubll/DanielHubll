            local UICornerOpt = Instance.new("UICorner")
            UICornerOpt.CornerRadius = UDim.new(0, 4)
            UICornerOpt.Parent = OptionsFrame
            
            local OptionsLayout = Instance.new("UIListLayout")
            OptionsLayout.Parent = OptionsFrame
            
            local isOpen = false
            
            local function addOptions()
                for _, option in ipairs(config.Options) do
                    local OptionButton = Instance.new("TextButton")
                    OptionButton.Size = UDim2.new(1, 0, 0, 30)
                    OptionButton.BackgroundTransparency = 1
                    OptionButton.Text = option
                    OptionButton.TextColor3 = Library.Theme.Text
                    OptionButton.TextSize = 14
                    OptionButton.Font = Enum.Font.Ubuntu
                    OptionButton.Parent = OptionsFrame
                    
                    OptionButton.MouseButton1Click:Connect(function()
                        DropButton.Text = option
                        OptionsFrame.Visible = false
                        isOpen = false
                        if config.Callback then
                            config.Callback(option)
                        end
                        if config.Flag then
                            Library.Flags[config.Flag] = option
                        end
                    end)
                end
                OptionsFrame.Size = UDim2.new(1, 0, 0, #config.Options * 30)
            end
            
            DropButton.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                OptionsFrame.Visible = isOpen
            end)
            
            addOptions()
            
            if config.Flag then
                Library.Flags[config.Flag] = config.Options[1]
            end
            
            return DropdownFrame
        end
        
