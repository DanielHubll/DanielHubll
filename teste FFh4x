                end)
                
                task.spawn(Callback)  
            end)  
        end  

        function Tab:AddSlider(sldOptions)  
            local Text = sldOptions.Text or "Slider"  
            local Min = sldOptions.Min or 0  
            local Max = sldOptions.Max or 100  
            local Default = sldOptions.Default or Min  
            local Suffix = sldOptions.Suffix or ""  
            local Side = sldOptions.Side or "Main1"  
            local Callback = sldOptions.Callback or function() end  
            local Flag = sldOptions.Flag or Text  
            local targetMain = self:GetMain(Side)  

            local SliderFrame = Instance.new("Frame")  
            SliderFrame.Name = "Slider_" .. Text  
