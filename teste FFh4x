                Library:Tween(v.Button, {BackgroundColor3 = Library.Theme.Sidebar}) 
                Library:Tween(v.Label, {TextColor3 = Library.Theme.SecondaryText})
                Library:Tween(v.Indicator, {Size = UDim2.new(0, 3, 0, 0)})
