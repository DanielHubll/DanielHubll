    -- ==================== FUNÇÕES GLOBAIS DA WINDOW ====================
    
    function Window:SetTheme(theme)
        for k, v in pairs(theme) do
            Library.Theme[k] = v
        end
    end
    
    -- Draggable
    local dragging = false
    local dragStart, startPos
    Painel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Painel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Painel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    -- Minimizar (duplo clique no logo)
    local minimized = false
    Logo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            minimized = not minimized
            HomeContainer.Visible = not minimized
            TabsFrame.Visible = not minimized and (#Tabs <= 3)
            TabsScrolling.Visible = not minimized and (#Tabs > 3)
            Painel.Size = minimized and UDim2.new(0, 120, 0, 372) or UDim2.new(0, 550, 0, 372)
        end
    end)
    
    -- Mostrar/Ocultar com tecla (RightShift por padrão)
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == config.ToggleKey or Enum.KeyCode.RightShift then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)
    
    -- Notificações
    function Window:Notify(config)
        config = config or {}
        local NotifyFrame = Instance.new("Frame")
        NotifyFrame.Size = UDim2.new(0, 200, 0, 50)
        NotifyFrame.Position = UDim2.new(0.5, -100, 0, -50)
        NotifyFrame.BackgroundColor3 = Library.Theme.Background
        NotifyFrame.BorderSizePixel = 0
        NotifyFrame.Parent = ScreenGui
        
        local UICorner = Instance.new("UICorner")
        UICorner.CornerRadius = UDim.new(0, 6)
        UICorner.Parent = NotifyFrame
        
        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.Text = config.Text or "Notificação"
        Label.TextColor3 = Library.Theme.Text
        Label.TextSize = 14
        Label.Font = Enum.Font.Ubuntu
        Label.Parent = NotifyFrame
        
        -- Animação de entrada
        NotifyFrame:TweenPosition(UDim2.new(0.5, -100, 0, 10), "Out", "Quad", 0.5)
        task.wait(config.Duration or 3)
        NotifyFrame:TweenPosition(UDim2.new(0.5, -100, 0, -50), "In", "Quad", 0.5)
        task.wait(0.5)
        NotifyFrame:Destroy()
    end
    
    -- Save/Load Config
    function Window:SaveConfig(name)
        local data = HttpService:JSONEncode(Library.Flags)
        if writefile and isfile then
            writefile(name .. ".json", data)
            Window:Notify({ Text = "Config salva: " .. name, Duration = 2 })
        end
    end
    
    function Window:LoadConfig(name)
        if readfile and isfile and isfile(name .. ".json") then
            local data = HttpService:JSONDecode(readfile(name .. ".json"))
            for k, v in pairs(data) do
                Library.Flags[k] = v
            end
            Window:Notify({ Text = "Config carregada: " .. name, Duration = 2 })
        end
    end
    
    return Window
end

return Library
