        local TabStroke = Instance.new("UIStroke")
        TabStroke.Color = Nexus.Theme.Outline
        TabStroke.Thickness = 1
        TabStroke.Transparency = 0.9
        TabStroke.Parent = TabButton

        if Window.Count > 3 then
            TabButton.Parent = TabsScrolling
        else
            TabButton.Parent = TabsContainer
        end

        UpdateTabsVisibility()

        local Page = Instance.new("Frame")  
        Page.Name = TabName .. "_Page"  
        Page.Parent = Container  
        Page.BackgroundTransparency = 1  
        Page.Size = UDim2.new(1, 0, 1, 0)  
        Page.Visible = false  

        local ContentFrame = Instance.new("ScrollingFrame")  
        ContentFrame.Name = "Content"  
        ContentFrame.Parent = Page  
        ContentFrame.BackgroundTransparency = 1  
        ContentFrame.Size = UDim2.new(1, 0, 1, 0)  
        ContentFrame.ScrollBarThickness = 2  
        ContentFrame.ScrollBarImageColor3 = Nexus.Theme.Accent  
        ContentFrame.ElasticBehavior = Enum.ElasticBehavior.Never  
        ContentFrame.CanvasSize = UDim2.new(0, 0, 0, 0)  
        ContentFrame.BorderSizePixel = 0  
        ContentFrame.ScrollingEnabled = true 
        RegisterScrollingFrame(ContentFrame)  

        local Tab = {  
            Mains = {},  
            ContentFrame = ContentFrame,  
            Button = TabButton,  
            Page = Page,  
        }  

        function Tab:GetMain(sideName)  
            sideName = sideName or "Main1"  

            if not self.Mains[sideName] then  
                local main = Instance.new("ScrollingFrame")  
                main.Name = sideName  
                main.Parent = self.ContentFrame  
                main.BackgroundColor3 = Nexus.Theme.Section  
                main.BorderSizePixel = 0  
                main.Size = UDim2.new(0, 204, 0, 350)  
                main.ScrollBarThickness = 2  
                main.ScrollBarImageColor3 = Nexus.Theme.Accent  
                main.ElasticBehavior = Enum.ElasticBehavior.Never  
                main.CanvasSize = UDim2.new(0, 0, 0, 0)  
                main.ScrollingEnabled = true 
                RegisterScrollingFrame(main)  

                local corner = Instance.new("UICorner")  
                corner.CornerRadius = UDim.new(0, 8)
                corner.Parent = main  

                local stroke = Instance.new("UIStroke")
                stroke.Color = Nexus.Theme.Outline
                stroke.Thickness = 1
                stroke.Transparency = 0.8
                stroke.Parent = main

                local layout = Instance.new("UIListLayout")  
                layout.Parent = main  
                layout.SortOrder = Enum.SortOrder.LayoutOrder  
                layout.Padding = UDim.new(0, 8)  
                layout.HorizontalAlignment = Enum.HorizontalAlignment.Center  

                local padding = Instance.new("UIPadding")  
                padding.Parent = main  
                padding.PaddingTop = UDim.new(0, 10)  
                padding.PaddingBottom = UDim.new(0, 10)  

                layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()  
                    local contentHeight = layout.AbsoluteContentSize.Y + 20  
                    main.CanvasSize = UDim2.new(0, 0, 0, contentHeight)  
                    local newHeight = math.min(contentHeight, 350)  
                    if main.Size.Y.Offset ~= newHeight then  
                        main.Size = UDim2.new(0, 204, 0, newHeight)  
                        self:UpdateLayout()  
                    end  
                end)  

                self.Mains[sideName] = main  
                self:UpdateLayout()  
            end  

            if self.Mains[sideName].Visible == false then  
                self.Mains[sideName].Visible = true  
                self.Mains[sideName].Size = UDim2.new(0, 204, 0, 350)  
                self:UpdateLayout()  
            end  

            return self.Mains[sideName]  
        end  

        function Tab:UpdateLayout()  
            local numMains = 0  
            for _, _ in pairs(self.Mains) do  
                numMains = numMains + 1  
            end  

            local currentX = 0  
            local currentY = 0  
            local maxRowHeight = 0  
            local mainSpacing = 10  

            local sortedMains = {}  
            for name, main in pairs(self.Mains) do  
                table.insert(sortedMains, {Name = name, Main = main})  
            end  
            table.sort(sortedMains, function(a, b) return a.Name < b.Name end)  

            for i, data in ipairs(sortedMains) do  
                local main = data.Main  
                if main.Visible then  
                    if i > 1 and (currentX + main.Size.X.Offset + mainSpacing) > self.ContentFrame.AbsoluteSize.X then  
                        currentX = 0  
                        currentY = currentY + maxRowHeight + mainSpacing  
                        maxRowHeight = 0  
                    end  

                    main.Position = UDim2.new(0, currentX, 0, currentY)  
                    currentX = currentX + main.Size.X.Offset + mainSpacing  
                    maxRowHeight = math.max(maxRowHeight, main.Size.Y.Offset)  
                end  
            end  

            local totalHeight = currentY + maxRowHeight  
            self.ContentFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)  
        end  

        function Tab:Select()  
            CloseAllDropdowns()  
            for _, tab in pairs(Nexus.Tabs) do  
                tab.Page.Visible = false  
                Nexus:Tween(tab.Button, {BackgroundColor3 = Nexus.Theme.Section})  
                if tab.Button:FindFirstChildOfClass("UIStroke") then
                    Nexus:Tween(tab.Button:FindFirstChildOfClass("UIStroke"), {Transparency = 0.9})
                end
            end  
            self.Page.Visible = true  
            Nexus:Tween(self.Button, {BackgroundColor3 = Nexus.Theme.Accent})  
            if self.Button:FindFirstChildOfClass("UIStroke") then
                Nexus:Tween(self.Button:FindFirstChildOfClass("UIStroke"), {Transparency = 0.3})
            end
            Nexus.CurrentTab = self  
        end  

        TabButton.MouseButton1Click:Connect(function()  
            if Nexus.IsDraggingWindow then return end  
            self:Select()  
        end)  

        table.insert(Nexus.Tabs, Tab)  

        if Nexus.CurrentTab == nil then  
            self:Select()  
        end  

        return Tab  
    end  

