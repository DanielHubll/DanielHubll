                ListScrolling.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)  
            end  
            ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)  

            local function SelectPlayer(player, entry)  
                if SelectedPlayer == player then  
                    SelectedPlayer = nil  
                    Library:Tween(entry, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)})  
                else  
                    for p, e in pairs(PlayerEntries) do  
                        Library:Tween(e, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)})  
                    end  

                    SelectedPlayer = player  
                    Library:Tween(entry, {BackgroundColor3 = Library.Theme.Accent})  
                end  

                Library.Flags[Flag] = SelectedPlayer  
                task.spawn(function() Callback(SelectedPlayer) end)  
            end  

            local function AddPlayerEntry(player)  
                if PlayerEntries[player] then return end  

                local Entry = Instance.new("TextButton")  
                Entry.Name = player.Name  
                Entry.Parent = ListScrolling  
                Entry.BackgroundColor3 = Color3.fromRGB(40, 40, 40)  
                Entry.BorderSizePixel = 0  
                Entry.Size = UDim2.new(1, 0, 0, 40)  
                Entry.Text = ""  
                Entry.AutoButtonColor = false  

                local ECorner = Instance.new("UICorner")  
                ECorner.CornerRadius = UDim.new(0, 6)  
                ECorner.Parent = Entry  

                local Avatar = Instance.new("ImageLabel")  
                Avatar.Name = "Avatar"  
                Avatar.Parent = Entry  
                Avatar.BackgroundTransparency = 1  
                Avatar.Position = UDim2.new(0, 5, 0, 5)  
                Avatar.Size = UDim2.new(0, 30, 0, 30)  

                local ACorner = Instance.new("UICorner")  
                ACorner.CornerRadius = UDim.new(1, 0)  
                ACorner.Parent = Avatar  

                task.spawn(function()  
                    local content, isReady = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)  
                    if isReady then  
                        Avatar.Image = content  
                    end  
                end)  

                local NameLabel = Instance.new("TextLabel")  
                NameLabel.Parent = Entry  
                NameLabel.BackgroundTransparency = 1  
                NameLabel.Position = UDim2.new(0, 40, 0, 0)  
                NameLabel.Size = UDim2.new(1, -45, 1, 0)  
                NameLabel.Text = player.DisplayName or player.Name  
                NameLabel.TextColor3 = Library.Theme.Text  
                NameLabel.TextSize = 14  
                NameLabel.TextXAlignment = Enum.TextXAlignment.Left  
                NameLabel.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json")  
                NameLabel.ClipsDescendants = true  

                Entry.MouseButton1Click:Connect(function()  
                    SelectPlayer(player, Entry)  
                end)  

                PlayerEntries[player] = Entry  
                UpdateCanvas()  
            end  

            local function RemovePlayerEntry(player)  
                if PlayerEntries[player] then  
                    PlayerEntries[player]:Destroy()  
                    PlayerEntries[player] = nil  
                    if SelectedPlayer == player then  
                        SelectedPlayer = nil  
                        Library.Flags[Flag] = nil  
                        task.spawn(function() Callback(nil) end)  
                    end  
                    UpdateCanvas()  
                end  
            end  

            for _, player in ipairs(Players:GetPlayers()) do  
                AddPlayerEntry(player)  
            end  

            local AddedConn = Players.PlayerAdded:Connect(AddPlayerEntry)  
            local RemovedConn = Players.PlayerRemoving:Connect(RemovePlayerEntry)  

            Container.Destroying:Connect(function()  
                AddedConn:Disconnect()  
                RemovedConn:Disconnect()  
            end)  

            return {  
                GetSelected = function() return SelectedPlayer end,  
                Refresh = function()  
                    for p, e in pairs(PlayerEntries) do e:Destroy() end  
                    PlayerEntries = {}  
                    for _, player in ipairs(Players:GetPlayers()) do AddPlayerEntry(player) end  
                end  
            }
        end

