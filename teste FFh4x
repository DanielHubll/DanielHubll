            Title.Size = UDim2.new(1, 0, 1, 0)
            Title.Text = Text
            Title.TextColor3 = Library.Theme.Accent
            Title.TextSize = 15
            Title.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json")
            Title.TextWrapped = true
        end

        function Tab:AddSeparator(Side)
            local Sep = Instance.new("Frame")
            Sep.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            Sep.BorderSizePixel = 0
            Sep.Size = UDim2.new(0, 180, 0, 1)
            Sep.Parent = (Side == "Main2" and Main2 or Main1)
        end

        return Tab
    end

    function Window:Notify(notifOptions)
        local Title = notifOptions.Title or "Notification"
        local Content = notifOptions.Content or ""
        local Duration = notifOptions.Duration or 5

        local NotifFrame = Instance.new("Frame")
        NotifFrame.Parent = ScreenGui
        NotifFrame.BackgroundColor3 = Library.Theme.Main
        NotifFrame.Position = UDim2.new(1, 10, 1, -100)
        NotifFrame.Size = UDim2.new(0, 250, 0, 80)
        
        local NCorner = Instance.new("UICorner")
        NCorner.Parent = NotifFrame
        
        local NStroke = Instance.new("UIStroke")
        NStroke.Color = Library.Theme.Accent
        NStroke.Thickness = 1
        NStroke.Parent = NotifFrame

        local NTitle = Instance.new("TextLabel")
        NTitle.Parent = NotifFrame
        NTitle.BackgroundTransparency = 1
        NTitle.Position = UDim2.new(0, 10, 0, 5)
        NTitle.Size = UDim2.new(1, -20, 0, 20)
        NTitle.Text = Title
        NTitle.TextColor3 = Library.Theme.Accent
        NTitle.TextSize = 15
        NTitle.TextXAlignment = Enum.TextXAlignment.Left
        NTitle.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Bold)

        local NContent = Instance.new("TextLabel")
        NContent.Parent = NotifFrame
        NContent.BackgroundTransparency = 1
        NContent.Position = UDim2.new(0, 10, 0, 30)
        NContent.Size = UDim2.new(1, -20, 0, 40)
        NContent.Text = Content
        NContent.TextColor3 = Library.Theme.Text
        NContent.TextSize = 13
        NContent.TextXAlignment = Enum.TextXAlignment.Left
        NContent.TextYAlignment = Enum.TextYAlignment.Top
        NContent.TextWrapped = true
        NContent.FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json")

        Library:Tween(NotifFrame, {Position = UDim2.new(1, -260, 1, -100)})
        
        task.delay(Duration, function()
            Library:Tween(NotifFrame, {Position = UDim2.new(1, 10, 1, -100)}, function()
                NotifFrame:Destroy()
            end)
        end)
    end

    return Window
end

function Library:SetTheme(newTheme)
    for i, v in pairs(newTheme) do
        if Library.Theme[i] then
            Library.Theme[i] = v
        end
    end
end

function Library:SaveConfig(name)
    local json = HttpService:JSONEncode(Library.Flags)
    writefile(name .. ".json", json)
end

function Library:LoadConfig(name)
    if isfile(name .. ".json") then
        local data = HttpService:JSONDecode(readfile(name .. ".json"))
        for i, v in pairs(data) do
            Library.Flags[i] = v
        end
    end
end

return Library
