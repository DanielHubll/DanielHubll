            local sliderKnobCorner = Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = sliderKnob})

            local value = default
            Library.Flags[flag] = value

            local function UpdateSlider(input)
                local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (pos * (max - min)) / increment) * increment
                value = math.clamp(value, min, max)

                sliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                sliderKnob.Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7)
                valueLabel.Text = tostring(value)
                Library.Flags[flag] = value
                callback(value)
            end

            local dragging = false
            sliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            return {
                Set = function(newValue)
                    value = math.clamp(newValue, min, max)
                    sliderFill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
                    sliderKnob.Position = UDim2.new((value - min) / (max - min), -7, 0.5, -7)
                    valueLabel.Text = tostring(value)
                    Library.Flags[flag] = value
                    callback(value)
                end,
                Get = function()
                    return value
                end
            }
        end

        function Tab:AddDropdown(dropdownConfig)
            dropdownConfig = dropdownConfig or {}
            local text = dropdownConfig.Text or "Dropdown"
            local side = dropdownConfig.Side or "Main1"
            local options = dropdownConfig.Options or {}
            local default = dropdownConfig.Default or (options[1] or "")
            local callback = dropdownConfig.Callback or function() end
            local flag = dropdownConfig.Flag or text

            local parent = side == "Main1" and main1Scroll or side == "Main2" and main2Scroll or main1Scroll

            local dropdownFrame = Create("Frame", {
                Name = text .. "Dropdown",
                Size = UDim2.new(1, -10, 0, 36),
                BackgroundTransparency = 1,
                ClipsDescendants = true,
                Parent = parent
            })

            local dropdownBtn = Create("TextButton", {
                Name = "Button",
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = Library.Theme.Main,
                Text = text .. ": " .. default,
                TextColor3 = Library.Theme.Text,
                FontFace = Library.Theme.Font,
                TextSize = 14,
                BorderSizePixel = 0,
                Parent = dropdownFrame
            })

            local dropdownCorner = Create("UICorner", {Parent = dropdownBtn})

            local arrow = Create("TextLabel", {
                Size = UDim2.new(0, 20, 0, 36),
                Position = UDim2.new(1, -25, 0, 0),
                BackgroundTransparency = 1,
                Text = "▼",
                TextColor3 = Library.Theme.Text,
                FontFace = Library.Theme.Font,
                TextSize = 12,
                Parent = dropdownBtn
            })

            local optionsFrame = Create("Frame", {
                Name = "Options",
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 0, 38),
                BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                BorderSizePixel = 0,
                ClipsDescendants = true,
                Parent = dropdownFrame
            })

            local optionsCorner = Create("UICorner", {Parent = optionsFrame})

            local optionsList = Create("UIListLayout", {
                Padding = UDim.new(0, 2),
                Parent = optionsFrame
            })

            local selected = default
            Library.Flags[flag] = selected
            local expanded = false

            local function ToggleDropdown()
                expanded = not expanded
                if expanded then
                    Tween(arrow, {Rotation = 180}, 0.2)
                    Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, math.min(#options * 30, 150))}, 0.2)
                    dropdownFrame.Size = UDim2.new(1, -10, 0, 38 + math.min(#options * 30, 150))
                else
                    Tween(arrow, {Rotation = 0}, 0.2)
                    Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
                    dropdownFrame.Size = UDim2.new(1, -10, 0, 36)
                end
            end

            dropdownBtn.MouseButton1Click:Connect(ToggleDropdown)

            for _, option in ipairs(options) do
                local optionBtn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                    Text = option,
                    TextColor3 = Library.Theme.Text,
                    FontFace = Library.Theme.Font,
                    TextSize = 13,
                    BorderSizePixel = 0,
                    Parent = optionsFrame
                })

                optionBtn.MouseEnter:Connect(function()
                    Tween(optionBtn, {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}, 0.15)
                end)

                optionBtn.MouseLeave:Connect(function()
                    Tween(optionBtn, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}, 0.15)
                end)

                optionBtn.MouseButton1Click:Connect(function()
                    selected = option
                    dropdownBtn.Text = text .. ": " .. selected
                    Library.Flags[flag] = selected
                    callback(selected)
                    ToggleDropdown()
                end)
            end

            return {
                Set = function(value)
                    selected = value
                    dropdownBtn.Text = text .. ": " .. selected
                    Library.Flags[flag] = selected
                    callback(selected)
                end,
                Get = function()
                    return selected
                end,
                Refresh = function(newOptions)
                    for _, child in ipairs(optionsFrame:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end
                    options = newOptions
                    for _, option in ipairs(options) do
                        local optionBtn = Create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = Color3.fromRGB(40, 40, 40),
                            Text = option,
                            TextColor3 = Library.Theme.Text,
                            FontFace = Library.Theme.Font,
                            TextSize = 13,
                            BorderSizePixel = 0,
                            Parent = optionsFrame
                        })
                        optionBtn.MouseButton1Click:Connect(function()
                            selected = option
                            dropdownBtn.Text = text .. ": " .. selected
                            Library.Flags[flag] = selected
                            callback(selected)
                            ToggleDropdown()
                        end)
                    end
                end
            }
        end

