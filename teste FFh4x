local Library = loadstring(game:HttpGet("URL_DA_SUA_LIBRARY"))()

local Window = Library:CreateWindow({
    Title = "FFh4x"
})

-- Cria uma Tab
local Home = Window:CreateTab({
    Name = "Home",
    Icon = "rbxassetid://SEU_ICONE_AQUI"
})

-- Main1 (coluna da esquerda, linha 0)
Home:AddButton({
    Text = "Botão Main1",
    Side = "Main1",
    Callback = function()
        print("Clicou no Main1!")
    end
})

-- Main2 (coluna da direita, linha 0)
Home:AddToggle({
    Text = "Toggle Main2",
    Side = "Main2",
    Default = false,
    Callback = function(value)
        print("Toggle:", value)
    end
})

-- Main3 (coluna da esquerda, linha 1 — embaixo do Main1)
Home:AddSlider({
    Text = "Slider Main3",
    Side = "Main3",
    Min = 0,
    Max = 100,
    Default = 50,
    Suffix = "%",
    Callback = function(value)
        print("Slider:", value)
    end
})

-- Main4 (coluna da direita, linha 1 — embaixo do Main2)
Home:AddDropdown({
    Text = "Dropdown Main4",
    Side = "Main4",
    List = {"Opção 1", "Opção 2", "Opção 3"},
    Callback = function(selected)
        print("Selecionado:", selected)
    end
})

-- Main5, Main6, Main7... funciona do mesmo jeito!
Home:AddLabel({
    Text = "Label no Main5",
    Side = "Main5"
})

-- Both continua funcionando (ocupa as 2 colunas)
Home:AddButton({
    Text = "Botão Largo",
    Side = "Both",
    Callback = function()
        print("Botão largo!")
    end
})

-- Notificação
Window:Notify({
    Title = "Sucesso",
    Content = "Library carregada!",
    Duration = 3
})
