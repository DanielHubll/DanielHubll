--// Utilitários
local function Create(instanceType, properties)
    local instance = Instance.new(instanceType)
    for prop, value in pairs(properties or {}) do
        instance[prop] = value
    end
    return instance
end

local function Tween(instance, properties, duration, easingStyle, easingDirection)
    local tween = TweenService:Create(
        instance,
        TweenInfo.new(duration or 0.3, easingStyle or Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out),
        properties
    )
    tween:Play()
    return tween
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging = false
    local dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function CreateRipple(parent, color)
    local ripple = Create("Frame", {
        Name = "Ripple",
        BackgroundColor3 = color or Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Parent = parent,
        ZIndex = parent.ZIndex + 1
    })

    local corner = Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = ripple
    })

    local maxSize = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2
    Tween(ripple, {Size = UDim2.new(0, maxSize, 0, maxSize), BackgroundTransparency = 1}, 0.5)

    task.delay(0.5, function()
        ripple:Destroy()
    end)
end

--// Sistema de Notificações
function Library:Notify(config)
    config = config or {}
    local title = config.Title or "Notificação"
    local text = config.Text or ""
    local duration = config.Duration or 3
    local type = config.Type or "Info"

    local notifGui = Create("ScreenGui", {
        Name = "FFh4xNotifications",
        Parent = LocalPlayer:WaitForChild("PlayerGui"),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })

    local notifFrame = Create("Frame", {
        Size = UDim2.new(0, 280, 0, 80),
        Position = UDim2.new(1, -300, 1, -100),
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        Parent = notifGui
    })

    local corner = Create("UICorner", {Parent = notifFrame})

    local accent = Create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = type == "Success" and Color3.fromRGB(0, 255, 100) or 
                          type == "Error" and Color3.fromRGB(255, 50, 50) or
                          type == "Warning" and Color3.fromRGB(255, 200, 0) or
                          Library.Theme.Accent,
        BorderSizePixel = 0,
        Parent = notifFrame
    })

    local titleLabel = Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 25),
        Position = UDim2.new(0, 15, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Library.Theme.Text,
        FontFace = Library.Theme.Font,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notifFrame
    })

    local textLabel = Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 15, 0, 33),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Library.Theme.DarkText,
        FontFace = Library.Theme.Font,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = notifFrame
    })

    notifFrame.Position = UDim2.new(1, 20, 1, -100)
    Tween(notifFrame, {Position = UDim2.new(1, -300, 1, -100)}, 0.4, Enum.EasingStyle.Back)

    task.delay(duration, function()
        Tween(notifFrame, {Position = UDim2.new(1, 20, 1, -100)}, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.wait(0.4)
        notifGui:Destroy()
    end)
end

--// Sistema de Tema
function Library:SetTheme(themeConfig)
    for key, value in pairs(themeConfig or {}) do
        if Library.Theme[key] ~= nil then
            Library.Theme[key] = value
        end
    end
end

--// Sistema de Save/Load Config
function Library:SaveConfig(fileName)
    local config = {}
    for flag, value in pairs(Library.Flags) do
        config[flag] = value
    end
    local json = HttpService:JSONEncode(config)
    writefile(fileName .. ".json", json)
    self:Notify({Title = "Configuração", Text = "Config salva com sucesso!", Type = "Success"})
end

function Library:LoadConfig(fileName)
    if isfile(fileName .. ".json") then
        local json = readfile(fileName .. ".json")
        local config = HttpService:JSONDecode(json)
        for flag, value in pairs(config) do
            if Library.Flags[flag] ~= nil then
                Library.Flags[flag] = value
            end
        end
        self:Notify({Title = "Configuração", Text = "Config carregada com sucesso!", Type = "Success"})
    else
        self:Notify({Title = "Configuração", Text = "Arquivo não encontrado!", Type = "Error"})
    end
end

