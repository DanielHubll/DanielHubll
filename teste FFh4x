            local SliderMain = Instance.new("Frame")
            SliderMain.Parent = SliderFrame
            SliderMain.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
            SliderMain.Position = UDim2.new(0.065, 0, 0, 52)
            SliderMain.Size = UDim2.new(0, 166, 0, 4)
            local SMCorner = Instance.new("UICorner"); SMCorner.Parent = SliderMain

            local SliderBar = Instance.new("Frame")
            SliderBar.Parent = SliderMain
            SliderBar.BackgroundColor3 = Library.Theme.Accent
            SliderBar.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
            local SBCorner = Instance.new("UICorner"); SBCorner.Parent = SliderBar

            local Cursor = Instance.new("Frame")
            Cursor.Parent = SliderMain
            Cursor.BackgroundColor3 = Library.Theme.Accent
            Cursor.Position = UDim2.new((Default - Min) / (Max - Min), -9, 0, -7)
            Cursor.Size = UDim2.new(0, 18, 0, 18)
            local CCorner = Instance.new("UICorner")
            CCorner.CornerRadius = UDim.new(1, 0); CCorner.Parent = Cursor

            local dragging = false
            local function Update(input)
                if Library.IsDraggingWindow then return end
                local pos = math.clamp((input.Position.X - SliderMain.AbsolutePosition.X) / SliderMain.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (Max - Min) * pos)
                Info.Text = tostring(val) .. Suffix
                SliderBar.Size = UDim2.new(pos, 0, 1, 0)
                Cursor.Position = UDim2.new(pos, -9, 0, -7)
                Library.Flags[Flag] = val
                Callback(val)
            end

            SliderMain.InputBegan:Connect(function(input)
                if Library.IsDraggingWindow then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Library.IsDraggingSlider = true
                    targetMain.ScrollingEnabled = false
                    self.ContentFrame.ScrollingEnabled = false
                    Update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and dragging then
                    dragging = false
                    Library.IsDraggingSlider = false
                    targetMain.ScrollingEnabled = true
                    self.ContentFrame.ScrollingEnabled = true
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input)
                end
            end)
            Library.Flags[Flag] = Default
        end

