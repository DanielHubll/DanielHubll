        local function UpdateColor()  
            local now = tick()  
            if now - LastUpdate < 1/60 then return end  
            LastUpdate = now  

            local color = Color3.fromHSV(H, S, V)  

            if color == LastColor then return end  
            LastColor = color  

            ColorDisplay.BackgroundColor3 = color  

            if H ~= LastH or S ~= LastS then  
                LastH = H  
                LastS = S  
                VGradient.Color = ColorSequence.new(Color3.fromHSV(H, S, 1), Color3.new())  
            end  

            Nexus.Flags[Flag] = color  

            task.spawn(function()  
                Callback(color)  
            end)  
        end  

        local function Toggle()  
            if Nexus.IsDraggingWindow or Nexus.IsDraggingColorPicker then return end  
            Opened = not Opened  
            Nexus:Tween(ColorPickerFrame, {Size = Opened and UDim2.new(0, 194, 0, 184) or UDim2.new(0, 194, 0, 34)})  
