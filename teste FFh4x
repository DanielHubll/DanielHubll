        SliderBar.BackgroundColor3 = Nexus.Theme.Accent  
        SliderBar.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)  
        local SBCorner = Instance.new("UICorner"); SBCorner.Parent = SliderBar  

        local Cursor = Instance.new("Frame")  
        Cursor.Parent = SliderMain  
        Cursor.BackgroundColor3 = Nexus.Theme.Accent  
        Cursor.Position = UDim2.new((Default - Min) / (Max - Min), -9, 0, -7)  
        Cursor.Size = UDim2.new(0, 18, 0, 18)  
        local CCorner = Instance.new("UICorner")  
        CCorner.CornerRadius = UDim.new(1, 0); CCorner.Parent = Cursor  

        local CursorStroke = Instance.new("UIStroke")
        CursorStroke.Color = Nexus.Theme.Outline
        CursorStroke.Thickness = 1
        CursorStroke.Transparency = 0.5
        CursorStroke.Parent = Cursor

        local dragging = false  
        local LastValue = Default  
        local LastUpdate = 0  

        local function UpdateSlider(input)  
            if Nexus.IsDraggingWindow then return end  

            local now = tick()  
            if now - LastUpdate < 1/60 then return end  
            LastUpdate = now  

            local pos = math.clamp((input.Position.X - SliderMain.AbsolutePosition.X) / SliderMain.AbsoluteSize.X, 0, 1)  
            local val = math.floor(Min + (Max - Min) * pos)  

            if val == LastValue then return end  
            LastValue = val  

            Info.Text = tostring(val) .. Suffix  
            SliderBar.Size = UDim2.new(pos, 0, 1, 0)  
            Cursor.Position = UDim2.new(pos, -9, 0, -7)  
            Nexus.Flags[Flag] = val  

            task.spawn(function()  
                Callback(val)  
            end)  
        end  

        SliderMain.InputBegan:Connect(function(input)  
            if Nexus.IsDraggingWindow then return end  
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then  
                dragging = true  
                Nexus.IsDraggingSlider = true  
