            Page.Visible = true  
            Library:Tween(TabButton, {BackgroundColor3 = Library.Theme.Component})  
            Library:Tween(TabLabel, {TextColor3 = Library.Theme.Accent})
            Library:Tween(Indicator, {Size = UDim2.new(0, 3, 0, 18)})
        end  

        TabButton.MouseButton1Click:Connect(function() Tab:Select() end)  
        table.insert(Window.Tabs, Tab)
        if Window.Count == 1 then Tab:Select() end  

