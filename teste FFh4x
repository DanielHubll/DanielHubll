        local NContent = Instance.new("TextLabel")  
        NContent.Parent = NotifFrame; NContent.BackgroundTransparency = 1; NContent.Position = UDim2.new(0, 10, 0, 25); NContent.Size = UDim2.new(1, -20, 0, 50); NContent.Text = Content; NContent.TextColor3 = Nexus.Theme.Text; NContent.TextSize = 12; NContent.TextXAlignment = Enum.TextXAlignment.Left; NContent.TextWrapped = true; NContent.Font = Enum.Font.Ubuntu  

        Nexus:Tween(NotifFrame, {Position = UDim2.new(1, -260, 1, -100)}, function()  
            task.delay(Duration, function()  
                Nexus:Tween(NotifFrame, {Position = UDim2.new(1, 10, 1, -100)}, function()  
                    NotifFrame:Destroy()  
                end)  
            end)  
        end)  
    end  

    function Window:SetTheme(themeOptions)  
        Nexus.Theme.Main = themeOptions.Main or Nexus.Theme.Main  
        Nexus.Theme.Accent = themeOptions.Accent or Nexus.Theme.Accent  
        Nexus.Theme.Section = themeOptions.Section or Nexus.Theme.Section  
        Nexus.Theme.Text = themeOptions.Text or Nexus.Theme.Text  
        Nexus.Theme.SecondaryText = themeOptions.SecondaryText or Nexus.Theme.SecondaryText  
        Nexus.Theme.DarkText = themeOptions.DarkText or Nexus.Theme.DarkText  
        Nexus.Theme.Outline = themeOptions.Outline or Nexus.Theme.Outline  

        -- Apply theme changes to existing elements (simplified for brevity, a full implementation would iterate all UI elements)
        Painel.BackgroundColor3 = Nexus.Theme.Main
        Sidebar.BackgroundColor3 = Nexus.Theme.Section
        UIStroke.Color = Nexus.Theme.Outline
        SidebarStroke.Color = Nexus.Theme.Outline

        for _, tab in pairs(Nexus.Tabs) do
            tab.Button.BackgroundColor3 = Nexus.Theme.Section
            if tab.Button:FindFirstChildOfClass("UIStroke") then
                tab.Button:FindFirstChildOfClass("UIStroke").Color = Nexus.Theme.Outline
            end
            -- More updates for tab content elements would go here
        end

        -- Re-apply current tab selection to update its color
        if Nexus.CurrentTab then
            Nexus.CurrentTab:Select()
        end
    end

    function Window:SaveConfig(configName)  
        configName = configName or "Default"  
        local config = {}  
        for k, v in pairs(Nexus.Flags) do  
            if typeof(v) == "Color3" then  
                config[k] = {R = v.R, G = v.G, B = v.B, Type = "Color3"}  
            elseif typeof(v) == "EnumItem" then  
                config[k] = {Name = v.Name, EnumType = v.EnumType.Name, Type = "EnumItem"}  
            else  
                config[k] = v  
            end  
        end  
        local success, err = pcall(function()  
            game:GetService("DataStoreService"):GetDataStore("NexusUI_Configs"):SetAsync(LocalPlayer.UserId .. "_" .. configName, HttpService:JSONEncode(config))  
        end)  
        if not success then warn("Failed to save config: ", err) end  
    end  

    function Window:LoadConfig(configName)  
        configName = configName or "Default"  
        local success, data = pcall(function()  
            return game:GetService("DataStoreService"):GetDataStore("NexusUI_Configs"):GetAsync(LocalPlayer.UserId .. "_" .. configName)  
        end)  
        if success and data then  
            local config = HttpService:JSONDecode(data)  
            for k, v in pairs(config) do  
                if type(v) == "table" and v.Type == "Color3" then  
                    Nexus.Flags[k] = Color3.fromRGB(v.R, v.G, v.B)  
                elseif type(v) == "table" and v.Type == "EnumItem" then  
                    Nexus.Flags[k] = Enum[v.EnumType][v.Name]  
                else  
                    Nexus.Flags[k] = v  
                end  
            end  
            -- Re-apply loaded flags to UI elements (requires iterating through all components and updating them)
            -- This part would need a more robust system to re-render or update all components based on flags.
            -- For now, components will reflect the loaded flags on creation.
        else  
            warn("Failed to load config or config not found.")  
        end  
    end  

    return Window  
end

return Nexus
