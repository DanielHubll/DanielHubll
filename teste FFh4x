            HeaderButton.Text = ""  
            HeaderButton.ZIndex = 5  
            HeaderButton.Activated:Connect(Toggle)  

            local VDragging, HSDragging = false, false  

            ValueBar.InputBegan:Connect(function(input)   
                if Library.IsDraggingWindow then return end  
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then   
                    VDragging = true  
                    Library.IsDraggingColorPicker = true  
                    SetAllScrollingEnabledFast(false)  
                end   
            end)  

            HueSatImg.InputBegan:Connect(function(input)   
                if Library.IsDraggingWindow then return end  
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then   
                    HSDragging = true  
                    Library.IsDraggingColorPicker = true  
                    SetAllScrollingEnabledFast(false)  
                end   
            end)  

            UserInputService.InputEnded:Connect(function(input)  
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then   
                    if VDragging or HSDragging then  
                        VDragging = false  
                        HSDragging = false  
                        Library.IsDraggingColorPicker = false  
                        SetAllScrollingEnabledFast(true)  
                    end  
                end  
            end)  

            RegisterInputConnection(function(input)  
                if VDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then  
                    local y = math.clamp((input.Position.Y - ValueBar.AbsolutePosition.Y) / ValueBar.AbsoluteSize.Y, 0, 1)  
                    if math.abs(V - (1 - y)) > 0.001 then  
                        V = 1 - y  
                        VCursor.Position = UDim2.new(0, 0, y, -1)  
                        UpdateColor()  
                    end  
                elseif HSDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then  
                    local x = math.clamp((input.Position.X - HueSatImg.AbsolutePosition.X) / HueSatImg.AbsoluteSize.X, 0, 1)  
                    local y = math.clamp((input.Position.Y - HueSatImg.AbsolutePosition.Y) / HueSatImg.AbsoluteSize.Y, 0, 1)  
